    section.features
      .feature-card.customer-card
        .feature-heading
          .feature-icon.icon-blue
            i.fa-solid.fa-users

          .feature-title
            h3 Customer Management
            .small-line.line-blue

        p
          | Keep track of customer details, contact information,
          | and service history in one centralized location.

        a.learn-more.learn-blue(href='/customers/records')
          | Learn More
          i.fa-solid.fa-arrow-right

      .feature-card.stock-card
        .feature-heading
          .feature-icon.icon-green
            i.fa-solid.fa-box-open

          .feature-title
            h3 Stock Management
            .small-line.line-green

        p
          | Monitor spare parts and workshop inventory levels
          | to avoid shortages and improve service turnaround
          | time.

        a.learn-more.learn-green(href='/registerStock/stockList')
          | Learn More
          i.fa-solid.fa-arrow-right

      .feature-card.vehicle-card
        .feature-heading
          .feature-icon.icon-red
            i.fa-solid.fa-car

          .feature-title
            h3 Vehicle Service Records
            .small-line.line-red

        p
          | Record and access vehicle service maintenance work
          | for each vehicle to ensure accurate and reliable
          | service logs.

        a.learn-more.learn-red(href='/records')
          | Learn More
          i.fa-solid.fa-arrow-right

