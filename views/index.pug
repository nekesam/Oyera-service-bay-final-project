extends layout

block navConfig
  - var showNavbar = false

block headStyles
  link(rel='stylesheet' href='/css/index.css')

block content
  main
    section.hero
      .hero-bg
      .hero-overlay

      .hero-content
        p.welcome Welcome to
        h2 Oyera Auto Service Bay
        .yellow-line

        p.hero-description
          | A centralized management system designed to help Oyera Auto Service Bay
          | efficiently manage customer, vehicle, service, technician, stock, and
          | business records in one place.
        .hero-buttons
          a.btn.btn-login(href='/login')
            i.fa-solid.fa-right-to-bracket
            | Login

          a.btn.btn-features(href='#features')
            i.fa-solid.fa-screwdriver-wrench
            | Explore Features

