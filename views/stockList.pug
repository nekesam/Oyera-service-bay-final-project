extends layout

block headStyles
  link(rel='stylesheet' href='/css/stockRecords.css')

block content
  .main-container
    - const activePage = 'inventory'
    include partials/sidebar
    main.content
      .stock-page
        - const totalItems = allStock.length
        - const totalQuantity = allStock.reduce((sum, stock) => sum + (Number(stock.quantity) || 0), 0)
        - const lowStockItems = allStock.filter((stock) => (Number(stock.quantity) || 0) < 5).length
        - const categoryCount = new Set(allStock.map((stock) => stock.category).filter(Boolean)).size

        .page-heading
          .heading-left
            .breadcrumb
              a(href='/dashboard') Dashboard
              i.fas.fa-chevron-right
              span Stock
            h1 Stock
            p Manage inventory levels, prices and available service parts.

          if canManageStock
            a.add-stock-btn(href='/registerStock/inventory')
              i.fas.fa-plus
              | Register Stock

        section.stock-stats
          article.stock-stat-card
            .stock-stat-icon.blue
              i.fas.fa-boxes-stacked
            .stock-stat-content
              p Stock Items
              h2= totalItems
              span.stat-note.blue-text
                i.fas.fa-circle
                | Registered items

          article.stock-stat-card
            .stock-stat-icon.green
              i.fas.fa-cubes
            .stock-stat-content
              p Total Quantity
              h2= totalQuantity
              span.stat-note.green-text
                i.fas.fa-circle
                | Units available

          article.stock-stat-card
            .stock-stat-icon.orange
              i.fas.fa-triangle-exclamation
            .stock-stat-content
              p Low Stock
              h2= lowStockItems
              span.stat-note.orange-text
                i.fas.fa-circle
                | Below threshold

          article.stock-stat-card
            .stock-stat-icon.purple
              i.fas.fa-layer-group
            .stock-stat-content
              p Categories
              h2= categoryCount
              span.stat-note.purple-text
                i.fas.fa-circle
                | Inventory groups

        .stock-layout
          section.stock-list.card-panel
            .list-header
              h2 Stock Records
              .list-controls
                .stock-search
                  i.fas.fa-search
                  input(type='text' placeholder='Search stock...')

            .table-wrapper
              table.stock-table
                thead
                  tr
                    th #
                    th Date
                    th Item
                    th Category
                    th Unit Price
                    th Quantity
                    th Status
                    th Actions
                tbody
                  if allStock.length
                    each stock, index in allStock
                      - const quantity = Number(stock.quantity) || 0
                      tr
                        td= index + 1
                        td= new Date(stock.dateAdded || stock.createdAt).toLocaleDateString()
                        td= stock.itemName
                        td= stock.category
                        td= (stock.unitPrice || stock.price || 0).toLocaleString()
                        td= quantity
                        td
                          span.status-badge(class=quantity > 0 ? 'in-stock' : 'out-of-stock')= quantity > 0 ? 'In Stock' : 'Out of Stock'
                        td
                          if canManageStock
                            a.btn.btn-sm.btn-outline-primary.me-1(href=`/registerStock/stock/edit/${stock._id}`)
                              i.bi.bi-pencil
                            form.d-inline(action=`/registerStock/stock/delete/${stock._id}` method='post' onsubmit="return confirm('Are you sure you want to delete this item?');")
                              button.btn.btn-sm.btn-danger(type='submit')
                                i.bi.bi-trash
                          else
                            span.text-muted View only
                  else
                    tr
                      td(colspan='8') No stock available yet.

            .table-footer
              span Showing 1 to #{allStock.length} of #{totalItems} stock items

          aside.stock-sidebar
            section.side-card
              h2 Quick Actions

              if canManageStock
                a.quick-action(href='/registerStock/inventory')
                  .quick-icon.blue
                    i.fas.fa-plus
                  .quick-text
                    strong Register Stock
                    span Add a new inventory item
                  i.fas.fa-chevron-right

                a.quick-action(href='/registerStock/addStock')
                  .quick-icon.green
                    i.fas.fa-file-circle-plus
                  .quick-text
                    strong Use Stock Form
                    span Capture detailed stock
                  i.fas.fa-chevron-right

              a.quick-action(href='/service-records')
                .quick-icon.orange
                  i.fas.fa-screwdriver-wrench
                .quick-text
                  strong Service Records
                  span View stock usage in services
                i.fas.fa-chevron-right

              a.quick-action(href='/dashboard')
                .quick-icon.purple
                  i.fas.fa-chart-column
                .quick-text
                  strong Inventory Reports
                  span View dashboard summary
                i.fas.fa-chevron-right

            section.side-card
              h2 Inventory Summary
              .summary-list
                .summary-row
                  span Total Items
                  strong= totalItems

                .summary-row
                  span Total Quantity
                  strong= totalQuantity

                .summary-row
                  span Low Stock Items
                  strong= lowStockItems

                .summary-row
                  span Categories
                  strong= categoryCount

        footer.page-footer
          span © 2026 Oyera Auto Service Bay Ltd. All rights reserved.
          span Professional care for every ride.
