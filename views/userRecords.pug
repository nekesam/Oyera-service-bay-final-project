extends layout

block headStyles
  link(rel='stylesheet' href='/css/userRecords.css')

block content
  .main-container
    - const activePage = 'technicians'
    include partials/sidebar
    main.content
      .user-records-page
        header.page-header
          h1 User Records
          p Registered users of Oyera Auto Service Bay.

        section.records-card
          .records-header
            h2 System Users
          .table-wrapper
            table.records-table
              thead
                tr
                  th Full Name
                  th Role
                  th Phone Number
                  th Email
                  th password
                  th Actions
              tbody
                each record in records
                  tr
                    td.fw-bold= record.fullName
                    td= record.role
                    td= record.phoneNumber || record.phone || record.identifier || ''
                    td= record.email
                    td= record.password
                    td
                      a.btn.btn-sm.btn-outline-primary.me-1(href =`/registerUser/user/edit/${record._id}`)
                        i.bi.bi-pencil
                      form.d-inline(action=`/registerUser/user/delete/${record._id}`, method ='post' onsubmit="return confirm('Are you sure you want to delete this user?');")
                        button.btn.btn-sm.btn-danger(type ='submit')
                          i.bi-trash
