extends layout

block headStyles
  link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/css/tom-select.min.css')
  link(rel='stylesheet' href='/css/vehicles.css')
  link(rel='stylesheet' href='/css/captureService.css')

block content
  .main-container
    - const activePage = 'services'
    include partials/sidebar
    main.content
      .register-vehicle-page
        .page-heading
          .heading-left
            .breadcrumb
              a(href='/dashboard') Dashboard
              i.fas.fa-chevron-right
              a(href='/service-records') Services
              i.fas.fa-chevron-right
              span Add Service
            h1 Add Service
            p Log a new service record and deduct stock used for the job.

        .register-card
          if errorMessage
            .form-alert= errorMessage

          .form-note
            strong Pricing Guide:
            | Engine Oil (UGX 79K-200K), Brake Fluid (UGX 13K-20K), Oil Filter (UGX 15K-20K), Alignment (UGX 30K), Balance (UGX 20K), Standard Labor (UGX 20K).

          form.register-form(action='/addRecord' method='POST')
            .form-grid
              .form-field
                label(for='customer') Customer Name
                select#customer(name='customer' required)
                  option(value='') Select customer
                  each customer in customers
                    - const customerFullName = `${customer.firstName} ${customer.lastName}`.trim()
                    option(
                      value=customer._id
                      selected=formData && formData.customer === String(customer._id)
                    )= customerFullName
              .form-field
                label(for='vehicle') Car Number Plate
                select#vehicle(name='vehicle' required)
                  option(value='') Select vehicle
                  each vehicle in vehicles
                    option(
                      value=vehicle._id
                      data-customer-id=vehicle.customerId
                      selected=formData && formData.vehicle === String(vehicle._id)
                    )= vehicle.registrationNo

              .form-field.span-2
                label(for='servicesDone') Services Performed
                select#servicesDone(name='servicesDone' multiple required)
                  option(value='Engine Oil and Filters' selected=formData && formData.servicesDone && formData.servicesDone.includes('Engine Oil and Filters')) Engine Oil and Filters
                  option(value='Gear Box Oil and Filters' selected=formData && formData.servicesDone && formData.servicesDone.includes('Gear Box Oil and Filters')) Gear Box Oil and Filters
                  option(value='Brake Fluids' selected=formData && formData.servicesDone && formData.servicesDone.includes('Brake Fluids')) Brake Fluids
                  option(value='Brake Pads Change' selected=formData && formData.servicesDone && formData.servicesDone.includes('Brake Pads Change')) Brake Pads Change
                  option(value='Greasing' selected=formData && formData.servicesDone && formData.servicesDone.includes('Greasing')) Greasing
                  option(value='Other Minor Repairs' selected=formData && formData.servicesDone && formData.servicesDone.includes('Other Minor Repairs')) Other Minor Repairs
                  option(value='Wheel Alignment' selected=formData && formData.servicesDone && formData.servicesDone.includes('Wheel Alignment')) Wheel Alignment
                  option(value='Wheel Balance' selected=formData && formData.servicesDone && formData.servicesDone.includes('Wheel Balance')) Wheel Balance

              .form-field.span-2
                label(for='technicians') Assigned Technician(s)
                select#technicians(name='technicians' multiple required)
                  each tech in technicians
                    option(value=tech._id selected=formData && formData.technicians && formData.technicians.includes(String(tech._id)))= tech.fullName

              .form-field.span-2
                label Parts & Oils Used
                #parts-container
                button.btn-add-part(type='button' onclick='addPartRow()')
                  i.fas.fa-plus
                  | Add Part / Oil

              .form-field.total-field
                label(for='totalCostDisplay') Total Cost (UGX, Auto Calculated)
                input#totalCostDisplay(type='number' readonly value='20000')

            .form-actions
              a.btn-secondary(href='/service-records') Cancel
              button.btn-primary(type='submit') Save Record & Deduct Stock

  template#part-row-template
    .part-row
      .part-row__item
        select(name='partIds' required)
          option(value="", disabled, selected) Select item...
          each items, categoryName in stockByCategory
            optgroup(label=categoryName)
              each item in items
                option(value=item._id data-price=(item.unitPrice || 0)) #{item.itemName} (In stock: #{item.quantity})
      .part-row__qty
        input(type='number' name='partQuantities' min='1' value='1' placeholder='Qty' required)
      button.part-row__remove(type='button' onclick="this.closest('.part-row').remove()" aria-label='Remove part')
        i.fas.fa-times

block pageScripts
  script(src='https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/js/tom-select.complete.min.js')
  script.
    const LABOUR_CHARGE = 20000;

    const SERVICE_PRICES = {
      'Wheel Alignment': 30000,
      'Wheel Balance': 20000
    };

    function recalculateTotal() {
      const servicesSelect = document.getElementById('servicesDone');
      const totalCostDisplay = document.getElementById('totalCostDisplay');
      const partRows = document.querySelectorAll('#parts-container .part-row');

      let servicesCost = 0;

      if (servicesSelect) {
        const selectedServices = Array.from(servicesSelect.selectedOptions)
          .map((opt) => opt.value);

        servicesCost = selectedServices.reduce(
          (sum, serviceName) =>
            sum + (SERVICE_PRICES[serviceName] || 0),
          0
        );
      }

      let partsCost = 0;

      partRows.forEach((row) => {
        const partSelect = row.querySelector('select[name="partIds"]');
        const qtyInput = row.querySelector('input[name="partQuantities"]');

        if (!partSelect || !qtyInput) return;

        const selectedOption =
          partSelect.options[partSelect.selectedIndex];

        const unitPrice =
          Number(selectedOption?.dataset?.price || 0);

        const qty = Number(qtyInput.value || 0);

        if (qty > 0) {
          partsCost += unitPrice * qty;
        }
      });

      totalCostDisplay.value =
        LABOUR_CHARGE + servicesCost + partsCost;
    }

    function addPartRow() {
      const container = document.getElementById('parts-container');
      const template = document.getElementById('part-row-template');

      const clone = template.content.cloneNode(true);

      container.appendChild(clone);

      const rows = container.querySelectorAll('.part-row');
      const newSelect = rows[rows.length - 1].querySelector('select[name="partIds"]');

      if (newSelect && window.TomSelect) {
        new TomSelect(newSelect, {
          create: false,
          onChange: recalculateTotal
        });
      }

      recalculateTotal();
    }

    function initSearchableSelects() {
      if (!window.TomSelect) return;

      new TomSelect('#customer', { create: false });

      new TomSelect('#servicesDone', {
        plugins: ['remove_button'],
        create: false,
        hideSelected: false,
        onChange: recalculateTotal
      });

      new TomSelect('#technicians', {
        plugins: ['remove_button'],
        create: false,
        hideSelected: false
      });
    }

    document.addEventListener('change', (event) => {
      if (
        event.target.matches(
          '#servicesDone, select[name="partIds"]'
        )
      ) {
        recalculateTotal();
      }
    });

    document.addEventListener('input', (event) => {
      if (
        event.target.matches(
          'input[name="partQuantities"]'
        )
      ) {
        recalculateTotal();
      }
    });

    document.addEventListener('click', (event) => {
      if (
        event.target.closest(
          'button[onclick*="remove"]'
        )
      ) {
        requestAnimationFrame(recalculateTotal);
      }
    });

    const customerSelect =
      document.getElementById('customer');

    const vehicleSelect =
      document.getElementById('vehicle');

    function filterVehiclesByCustomer() {

      if (!customerSelect || !vehicleSelect) {
        return;
      }

      const selectedCustomerId =
        customerSelect.value;

      Array.from(vehicleSelect.options).forEach(
        (option, index) => {

          if (index === 0) {
            option.hidden = false;
            return;
          }

          const vehicleCustomerId =
            option.dataset.customerId;

          option.hidden =
            !selectedCustomerId ||
            vehicleCustomerId !== selectedCustomerId;

          if (option.hidden && option.selected) {
            option.selected = false;
            vehicleSelect.value = '';
          }
        }
      );
    }

    customerSelect?.addEventListener('change', () => {
      vehicleSelect.value = '';
      filterVehiclesByCustomer();
    });

    document.addEventListener('DOMContentLoaded', () => {
      initSearchableSelects();
      addPartRow();
      recalculateTotal();
      filterVehiclesByCustomer();
    });
