doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')

    title #{pageTitle ? pageTitle + ' | ' : ''}Oyera Auto Service Bay

    link(rel='preconnect' href='https://fonts.googleapis.com')
    link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin)
    link(rel='stylesheet' href='https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap')

    //- Bootsrap CSS
    link(
      rel='stylesheet'
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css'
      integrity='sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB'
      crossorigin='anonymous'
    )

    //- Bootstrap Icons
    link(
      rel='stylesheet'
      href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css'
    )

    //- Font Awesome
    link(
      rel='stylesheet'
      href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css'
    )

    link(rel='stylesheet' href='/css/layout.css')

    block headStyles

    //- design system last, so it wins over the per-page stylesheets above
    link(rel='stylesheet' href='/css/ui.css')

  body

    block navConfig
      - var showNavbar = true

    //- Top Navigation Bar
    header.nav-bar(class=showNavbar ? '' : 'd-none')

      
      //- LEFT - LOGO

      .nav-left

        a.brand(href='/')
          img(
            src='/images/bay-logo.png'
            alt='Oyera Auto Service Bay'
          )

        .brand-divider

        .page-context
          span.context-label OYERA AUTO SERVICE BAY
          span.context-subtitle Management System


      //- CENTER - GLOBAL SEARCH

      .nav-center

        form.global-search(action='/search' method='get')

          .search-icon
            i.fa-solid.fa-magnifying-glass

          input(
            type='search'
            name='q'
            placeholder='Search customers, vehicles, stock...'
            autocomplete='off'
          )

          .search-shortcut
            span Ctrl
            span K


      //- RIGHT - SYSTEM STATUS, DATE, NOTIFICATIONS, USER PROFILE
      .nav-right
        //- Date
        .nav-date
          i.fa-regular.fa-calendar
          span#currentDate


        //- Notifications (real data, see services/notificationService.mjs)
        - var bell = (typeof notifications !== 'undefined' && notifications) ? notifications : { items: [] }
        .notification-wrapper

          button.notification-btn(
            type='button'
            aria-label='Notifications'
            id='notificationButton'
          )

            i.fa-regular.fa-bell

            if bell.items.length
              span.notification-badge= bell.items.length

          .notification-dropdown#notificationDropdown

            .dropdown-header
              .notification-title Notifications
              span.notification-count-text #{bell.items.length ? bell.items.length + ' need attention' : 'All clear'}

            if !bell.items.length
              .notification-item
                .notification-item-icon.green
                  i.fa-solid.fa-check
                .notification-item-content
                  strong Nothing needs attention
                  span Stock levels and jobs look fine.

            each item in bell.items
              a.notification-item(href=item.href style='text-decoration:none;color:inherit')
                .notification-item-icon(class=item.tone)
                  i.fa-solid(class=item.icon)
                .notification-item-content
                  strong= item.title
                  span= item.text


        //- Divider
        .nav-divider


        //- User profile
        .user-menu

          button.user-profile-btn(
            type='button'
            id='profileButton'
          )

            .user-avatar
              if user && user.fullName
                - var initials = user.fullName.split(' ').map(name => name.charAt(0)).join('').substring(0, 2).toUpperCase()
                span= initials
              else
                i.fa-solid.fa-user

            .user-details

              if user
                strong= user.fullName
                span= user.role
              else 
                span Administrator
                strong Administrator

                
            i.fa-solid.fa-chevron-down.profile-chevron


          //- Profile dropdown
          .profile-dropdown#profileDropdown

            .profile-dropdown-header

              .large-avatar
                if user && user.fullName
                  span= initials
                else
                  i.fa-solid.fa-user

              .profile-header-info

                if user
                  strong= user.fullName
                else
                  strong Admin

                span= user ? user.role : ''

            .profile-divider

            if user && user.role === 'Admin'
              a.profile-option(href='/signup')
                i.fa-regular.fa-user
                span Add User
              a.profile-option(href='/audit')
                i.fa-solid.fa-clock-rotate-left
                span Audit log
              .profile-divider

            a.profile-option.logout-option(href='/logout')
              i.fa-solid.fa-arrow-right-from-bracket
              span Logout


    if flash && flash.message
      - var flashBad = flash.type === 'error' || flash.type === 'danger'
      .app-flash(class='app-flash--' + (flashBad ? 'danger' : (flash.type || 'success')) role='status')
        i.app-flash__icon.fas(class=flashBad ? 'fa-circle-exclamation' : 'fa-circle-check')
        span.app-flash__text= flash.message
        button.app-flash__close(type='button' aria-label='Dismiss message') &times;

    //- Page Content

    main.page-wrapper
      block content


    block pageScripts

    script.
      (function () {
        var flash = document.querySelector('.app-flash');
        if (!flash) return;
        var remove = function () {
          flash.classList.add('app-flash--hide');
          setTimeout(function () { flash.remove(); }, 300);
        };
        var closeBtn = flash.querySelector('.app-flash__close');
        if (closeBtn) closeBtn.addEventListener('click', remove);
        setTimeout(remove, 4500);
      })();

    //- Navbar functionality
    script.
      document.addEventListener('DOMContentLoaded', function () {

    
        // Current date

        const dateElement = document.getElementById('currentDate');

        if (dateElement) {
          const today = new Date();

          const options = {
            weekday: 'short',
            month: 'short',
            day: 'numeric'
          };

          dateElement.textContent =
            today.toLocaleDateString('en-US', options);
        }


        //- Notification dropdown

        const notificationButton =
          document.getElementById('notificationButton');

        const notificationDropdown =
          document.getElementById('notificationDropdown');

        if (notificationButton && notificationDropdown) {

          notificationButton.addEventListener('click', function (event) {

            event.stopPropagation();

            notificationDropdown.classList.toggle('show');

            profileDropdown.classList.remove('show');

          });

        }


        //- Profile dropdown

        const profileButton =
          document.getElementById('profileButton');

        const profileDropdown =
          document.getElementById('profileDropdown');

        if (profileButton && profileDropdown) {

          profileButton.addEventListener('click', function (event) {

            event.stopPropagation();

            profileDropdown.classList.toggle('show');

            if (notificationDropdown) {
              notificationDropdown.classList.remove('show');
            }

          });

        }


        //- Close dropdowns when clicking outside

        document.addEventListener('click', function () {

          if (notificationDropdown) {
            notificationDropdown.classList.remove('show');
          }

          if (profileDropdown) {
            profileDropdown.classList.remove('show');
          }

        });


        //- Prevent dropdown from closing
        //- when clicked inside

        if (notificationDropdown) {

          notificationDropdown.addEventListener(
            'click',
            function (event) {
              event.stopPropagation();
            }
          );

        }

        if (profileDropdown) {

          profileDropdown.addEventListener(
            'click',
            function (event) {
              event.stopPropagation();
            }
          );

        }

      });