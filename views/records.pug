extends layout
include partials/badges

block content
  .main-container
    - const activePage = 'services'
    include partials/sidebar

    main.content
      .ui-page
        - const showMoney = permissions && permissions.showPayments
        - const canManage = !permissions || permissions.canManageServices
        - const canExport = permissions && permissions.showReports
        - const params = { q: filters.q, status: filters.status, payment: filters.payment }
        - const pageLink = (page) => { const sp = new URLSearchParams(); Object.entries(Object.assign({}, params, { page: page > 1 ? page : '' })).forEach(([k, v]) => { if (v) sp.set(k, v) }); const t = sp.toString(); return t ? '?' + t : '?' }

        header.ui-page-header
          div
            .ui-crumbs
              a(href='/dashboard') Dashboard
              i.fas.fa-chevron-right
              span Services
            h1 Services
            p Every job the bay has taken on, who worked on it, and where it stands.
          .ui-actions
            if canExport
              a.ui-btn(href='/reports/export/services.csv')
                i.fas.fa-file-csv
                | Export CSV
            a.ui-btn.primary(href='/addRecord')
              i.fas.fa-plus
              | Add service

        section.ui-grid.fit(style='margin-bottom:20px')
          article.ui-card.ui-stat
            .ui-stat-icon: i.fas.fa-clipboard-list
            div
              .ui-stat-label Total jobs
              .ui-stat-value= summary.jobs
          article.ui-card.ui-stat
            .ui-stat-icon.sky: i.fas.fa-gears
            div
              .ui-stat-label In progress
              .ui-stat-value= (statusCounts['In progress'] || 0) + (statusCounts['Booked'] || 0)
          article.ui-card.ui-stat
            .ui-stat-icon.amber: i.fas.fa-car-side
            div
              .ui-stat-label Ready for pickup
              .ui-stat-value= statusCounts['Ready for pickup'] || 0
          if showMoney
            article.ui-card.ui-stat
              .ui-stat-icon.red: i.fas.fa-coins
              div
                .ui-stat-label Still to collect
                .ui-stat-value UGX #{Number(summary.outstanding).toLocaleString('en-US')}
                .ui-stat-note of UGX #{Number(summary.billed).toLocaleString('en-US')} billed
          else
            article.ui-card.ui-stat
              .ui-stat-icon.green: i.fas.fa-circle-check
              div
                .ui-stat-label Collected
                .ui-stat-value= statusCounts['Collected'] || 0

        section.ui-card
          form.ui-toolbar(method='get' action='/records')
            input.ui-input.grow(type='search' name='q' value=filters.q placeholder='Search customer, plate or vehicle…' aria-label='Search')
            select.ui-select(name='status' aria-label='Job status')
              option(value='') All statuses
              each s in statuses
                option(value=s selected=filters.status === s)= s
            if showMoney
              select.ui-select(name='payment' aria-label='Payment status')
                option(value='') Any payment
                each p in ['Unpaid', 'Part paid', 'Paid']
                  option(value=p selected=filters.payment === p)= p
            button.ui-btn(type='submit')
              i.fas.fa-magnifying-glass
              | Filter
            if filters.q || filters.status || filters.payment
              a.ui-btn(href='/records') Clear

          if records.length
            .ui-table-wrap
              table.ui-table
                thead
                  tr
                    th Date
                    th Customer
                    th Vehicle
                    th Services
                    th Technicians
                    th Status
                    if showMoney
                      th Payment
                    th.num Total (UGX)
                    th
                tbody
                  each record in records
                    tr
                      td.muted(style='white-space:nowrap')= new Date(record.date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })
                      td
                        a.row-link(href=`/records/${record._id}`)
                          if record.customer
                            = `${record.customer.firstName} ${record.customer.lastName}`
                          else
                            | Unknown customer
                      td
                        if record.vehicle
                          span.ui-badge.grey= record.vehicle.registrationNo
                        else
                          span.muted N/A
                      td(style='max-width:220px')= (record.servicesDone || []).join(', ')
                      td.muted= (record.technicians || []).filter(Boolean).map((t) => t.fullName).join(', ')
                      td: +jobBadge(record.jobStatus)
                      if showMoney
                        td: +payBadge(record.paymentStatus)
                      td.num
                        +money(record.totalCost)
                      td.num
                        a.ui-btn.small(href=`/records/${record._id}`) View
                        if canManage
                          |
                          a.ui-btn.small(href=`/records/edit/${record._id}`) Edit

            .ui-pagination
              span Showing #{pagination.from}–#{pagination.to} of #{pagination.totalItems} jobs
              .pager
                if pagination.hasPrev
                  a.ui-btn.small(href=pageLink(pagination.page - 1)) ← Previous
                span.ui-btn.small(style='pointer-events:none;background:var(--bg)') Page #{pagination.page} of #{pagination.totalPages}
                if pagination.hasNext
                  a.ui-btn.small(href=pageLink(pagination.page + 1)) Next →
          else
            .ui-empty
              i.fas.fa-clipboard-list
              strong No jobs match
              span Try a different search, or
                a(href='/addRecord') add a service
                | .
