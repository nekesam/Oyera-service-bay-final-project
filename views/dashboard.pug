extends layout
include partials/badges

block content
  .main-container
    - const activePage = 'dashboard'
    include partials/sidebar

    main.content
      .ui-page
        - const showMoney = permissions && permissions.showReports
        - const showPayments = permissions && permissions.showPayments
        - const firstName = user && user.fullName ? user.fullName.split(' ')[0] : 'there'
        - const today = new Date().toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })

        header.ui-page-header
          div
            h1 Welcome back, #{firstName}
            p #{today} · here's what's happening at the bay.
          .ui-actions
            a.ui-btn.primary(href='/addRecord')
              i.fas.fa-screwdriver-wrench
              | New service
            if !permissions || permissions.showCustomers
              a.ui-btn(href='/customers/register')
                i.fas.fa-user-plus
                | Customer
            if !permissions || permissions.canManageVehicles
              a.ui-btn(href='/vehicles/register')
                i.fas.fa-car
                | Vehicle
            if !permissions || permissions.canManageStock
              a.ui-btn(href='/registerStock/addStock')
                i.fas.fa-box
                | Stock

        section.ui-grid.fit(style='margin-bottom:18px')
          a.ui-card.ui-stat(href='/records?status=In%20progress' style='text-decoration:none')
            .ui-stat-icon.sky: i.fas.fa-gears
            div
              .ui-stat-label Active jobs
              .ui-stat-value= stats.activeJobs
              .ui-stat-note #{stats.jobsToday} started today
          if showMoney
            a.ui-card.ui-stat(href='/records' style='text-decoration:none')
              .ui-stat-icon: i.fas.fa-coins
              div
                .ui-stat-label Billed in total
                .ui-stat-value UGX #{Number(stats.billed).toLocaleString('en-US')}
                .ui-stat-note UGX #{Number(stats.todayRevenue).toLocaleString('en-US')} today
          if showPayments
            a.ui-card.ui-stat(href='/records?payment=Unpaid' style='text-decoration:none')
              .ui-stat-icon.red: i.fas.fa-hand-holding-dollar
              div
                .ui-stat-label Still to collect
                .ui-stat-value UGX #{Number(stats.outstanding).toLocaleString('en-US')}
                .ui-stat-note UGX #{Number(stats.received).toLocaleString('en-US')} received
          a.ui-card.ui-stat(href='/vehicles' style='text-decoration:none')
            .ui-stat-icon.green: i.fas.fa-car
            div
              .ui-stat-label Vehicles
              .ui-stat-value= stats.vehicles
              .ui-stat-note #{stats.customers} customers
          if !showPayments
            a.ui-card.ui-stat(href='/registerStock/stockList' style='text-decoration:none')
              .ui-stat-icon.amber: i.fas.fa-triangle-exclamation
              div
                .ui-stat-label Low stock
                .ui-stat-value= lowStock.length
                .ui-stat-note items to reorder
          if showMoney && !showPayments
            a.ui-card.ui-stat(href='/registerStock/stockList' style='text-decoration:none')
              .ui-stat-icon.amber: i.fas.fa-warehouse
              div
                .ui-stat-label Stock value
                .ui-stat-value UGX #{Number(stats.inventoryValue).toLocaleString('en-US')}

        if showMoney
          section.ui-grid.main-side(style='margin-bottom:18px')
            article.ui-card
              .ui-card-head
                h2 Revenue, last 6 months
                if showPayments
                  a(href='/reports') Reports
              .ui-card-body
                div(style='position:relative;height:260px')
                  canvas#revenueChart(aria-label='Revenue by month' role='img')
            article.ui-card
              .ui-card-head
                h2 Jobs by stage
              .ui-card-body
                div(style='position:relative;height:260px')
                  canvas#statusChart(aria-label='Jobs by stage' role='img')

        section.ui-grid.main-side(style='margin-bottom:18px')
          article.ui-card
            .ui-card-head
              h2 Recent jobs
              a(href='/records') View all
            .ui-card-body(style='padding-top:8px')
              if recentRecords.length
                .ui-table-wrap
                  table.ui-table
                    thead
                      tr
                        th Date
                        th Customer
                        th Vehicle
                        th Status
                        if showMoney
                          th.num Total (UGX)
                    tbody
                      each record in recentRecords
                        tr
                          td.muted= new Date(record.date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short' })
                          td
                            a.row-link(href=`/records/${record._id}`)
                              if record.customer
                                = `${record.customer.firstName} ${record.customer.lastName}`
                              else
                                | Unknown customer
                          td= record.vehicle ? record.vehicle.registrationNo : 'N/A'
                          td: +jobBadge(record.jobStatus)
                          if showMoney
                            td.num: +money(record.totalCost)
              else
                .ui-empty
                  i.fas.fa-clipboard-list
                  strong No jobs yet
                  span Add the first service to see it here.

          article.ui-card
            .ui-card-head
              h2 Low stock
              a(href='/registerStock/stockList') Stock
            .ui-card-body
              if lowStock.length
                ul.ui-bars
                  each item in lowStock
                    - const level = item.reorderLevel !== undefined && item.reorderLevel !== null ? item.reorderLevel : 5
                    li
                      .bar-row
                        span= item.itemName
                        span #{item.quantity} left
                      .track
                        .fill(style=`width:${Math.min(100, Math.round(((item.quantity || 0) / Math.max(level, 1)) * 100))}%;background:${(item.quantity || 0) === 0 ? 'var(--danger)' : 'var(--accent)'}`)
              else
                .ui-empty(style='padding:24px 8px')
                  i.fas.fa-circle-check
                  strong Stock looks healthy
                  span Nothing is running low.

        section.ui-grid.cols-2
          article.ui-card
            .ui-card-head
              h2 Most used parts
            .ui-card-body
              if parts.length
                - const maxQty = Math.max.apply(null, parts.map((p) => p.quantity)) || 1
                ul.ui-bars
                  each part in parts
                    li
                      .bar-row
                        span= part.name
                        span #{part.quantity} used
                      .track
                        .fill(style=`width:${Math.round((part.quantity / maxQty) * 100)}%`)
              else
                p.ui-empty(style='padding:16px 0') No parts used yet.
          article.ui-card
            .ui-card-head
              h2 Team workload
            .ui-card-body
              if workload.length
                - const maxJobs = Math.max.apply(null, workload.map((w) => w.jobs)) || 1
                ul.ui-bars
                  each person in workload
                    li
                      .bar-row
                        span= person.name
                        span #{person.jobs} job#{person.jobs === 1 ? '' : 's'}
                      .track
                        .fill(style=`width:${Math.round((person.jobs / maxJobs) * 100)}%`)
              else
                p.ui-empty(style='padding:16px 0') No jobs assigned yet.

block pageScripts
  if showMoney
    script#chart-data(type='application/json')!= chartsJson
    script(src='https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js')
    script(src='/js/dashboard-charts.js')
