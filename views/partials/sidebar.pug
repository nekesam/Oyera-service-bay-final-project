aside.side-bar
  ul.sidebar-menu
    li
      a(class=activePage === 'dashboard' ? 'active' : '' href='/dashboard')
        i.fa-solid.fa-chart-line
        |  Dashboard
    if typeof permissions === 'undefined' || permissions.showCustomers
      li
        a(class=activePage === 'customers' ? 'active' : '' href='/customers/records')
          i.fa-solid.fa-users
          |  Customers
    if typeof permissions === 'undefined' || permissions.showVehicles
      li
        a(class=activePage === 'vehicles' ? 'active' : '' href='/vehicles')
          i.fa-solid.fa-car
          |  Vehicles
    if typeof permissions === 'undefined' || permissions.showTechnicians
      li
        a(class=activePage === 'technicians' ? 'active' : '' href='/technicians')
          i.fa-solid.fa-user-gear
          |  Technicians
    if typeof permissions === 'undefined' || permissions.showInventory
      li
        a(class=activePage === 'inventory' ? 'active' : '' href='/registerStock/stockList')
          i.fa-solid.fa-boxes-stacked
          |  Stock
    if typeof permissions === 'undefined' || permissions.showServices
      li
        a(class=activePage === 'services' ? 'active' : '' href='/service-records')
          i.fa-solid.fa-screwdriver-wrench
          |  Services
    if typeof permissions === 'undefined' || permissions.showReports
      li
        a(class=activePage === 'reports' ? 'active' : '' href='/reports')
          i.fa-solid.fa-chart-pie
          |  Reports
    li
      a(href='/logout')
        i.fas.fa-sign-out-alt
        |  Logout
